---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';
import '../styles/booking.css';
import presskit from '../data/presskit.json';
import releases from '../data/releases.json';

const featured = releases[0];
const description =
  'Booking & press — everything promoters need: press text, photos, bios and tech riders for loophole, Zürich.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Booking — loophole</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Booking — loophole" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/booking-hero.jpg" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="bk-header">
      <div class="bk-nav-inner">
        <button class="nav-toggle" type="button" data-nav-toggle aria-controls="bk-menu" aria-expanded="false" aria-label="Open menu">
          <span class="nav-toggle-bars"></span>
        </button>
        <div class="bk-nav-menu" id="bk-menu">
          <nav class="bk-nav-links" aria-label="Main">
            <a href="/">← Site</a>
            <a href="#downloads">Downloads</a>
            <a href="#photos">Photos</a>
            <a href="#music">Music</a>
          </nav>
          <div class="bk-nav-rule"></div>
          <div class="bk-nav-side">
            <a class="icon icon-instagram" href="https://www.instagram.com/loophole_sessions" aria-label="Instagram"></a>
            <a class="icon icon-tiktok" href="https://www.tiktok.com/@loophole_sessions" aria-label="TikTok"></a>
            <a class="bk-nav-contact" href="mailto:michel@rarealpine.ch">Contact</a>
          </div>
        </div>
      </div>
    </header>

    <section class="bk-hero">
      <img src="/images/booking-hero.jpg" alt="loophole" />
      <div class="bk-hero-gradient"></div>
      <h1>Dear promoter</h1>
    </section>

    <section class="bk-section bk-intro">
      <p>
        Great to have you here! We've put together everything you need: press text, photos, bios and our tech
        rider – available for individual download or as a convenient ZIP package. If there's anything you can't
        find or if you have any questions, please don't hesitate to get in
        <a href="mailto:michel@rarealpine.ch">touch</a>.
      </p>
    </section>

    <section id="downloads" class="bk-section">
      <div class="bk-section-head bk-downloads-head">
        <h2>Press kit</h2>
        <span class="bk-section-label">PDF · ZIP</span>
      </div>
      {presskit.files.map((f) => (
        <a class="dl-row" href={f.url} download>
          <span class="dl-name">{f.name}</span>
          <span class="dl-kind">{f.kind}</span>
          <span class="dl-arrow">↓</span>
        </a>
      ))}
      <a class="pill-solid" href={presskit.completeKit} download>Download complete press kit</a>
    </section>

    <section id="photos" class="bk-section">
      <div class="bk-section-head bk-photos-head">
        <h2>Photos</h2>
        <span class="bk-section-label">Credit: Thomas Zeller</span>
      </div>
      <div class="photo-grid">
        {presskit.photos.map((p) => (
          <a class="photo-tile" href={p}>
            <img src={p} alt="loophole press photo" loading="lazy" />
          </a>
        ))}
      </div>
    </section>

    <section id="music" class="bk-section">
      <div class="bk-section-head bk-music-head">
        <h2>Music</h2>
      </div>
      <div class="bk-music-grid">
        <a href={featured.url}>
          <img src={featured.cover} alt={featured.title} loading="lazy" />
        </a>
        <div>
          <p class="bk-music-text">«{featured.title}» ({featured.year}) is our latest release.</p>
          <div class="bk-music-buttons">
            <a class="pill-solid" href={featured.url}>Listen</a>
            <a class="pill-outline" href="https://music.rarealpine.ch/lhartistpages">Full catalogue</a>
          </div>
        </div>
      </div>
    </section>

    <footer class="bk-footer">
      <a class="bk-footer-mail" href="mailto:michel@rarealpine.ch">michel@rarealpine.ch</a>
      <div class="bk-footer-copyright">© 2026 loophole · Zürich</div>
    </footer>

    <script>
      import { initNav } from '../scripts/nav.js';
      initNav();
    </script>
  </body>
</html>
